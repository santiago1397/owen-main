# Copy to .env.prod on the server, fill in real values, chmod 600. Never commit.

# Traefik Host() rule uses this: api.${APP_DOMAIN} for the backend.
APP_DOMAIN=example.com

ENVIRONMENT=production
DEBUG=false

# Frontend origin allowed to call the API (frontend lives on app.<APP_DOMAIN>).
CORS_ORIGINS=https://app.example.com

# Native host Postgres (see SERVER_SETUP.md PostgreSQL strategy, Option A).
# Create: sudo -u postgres createuser callmon; createdb -O callmon callmon
# And add the callmon-net bridge subnet to pg_hba.conf (NOT just 172.17/16).
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=callmon
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=callmon

# Auth — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

BUSINESS_TZ=America/New_York

# Twilio: auth token verifies X-Twilio-Signature; account SID enables reconciliation pulls.
# Primary account. Also the fallback single account when TWILIO_ACCOUNTS is unset.
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME

# Multiple Twilio accounts (optional). JSON list; each account becomes its own provider
# identity (its own Provider row / provider name). When set, this is the FULL list —
# include the primary account explicitly. When empty, the single account above is used.
# Example:
# TWILIO_ACCOUNTS=[{"name":"twilio","sid":"ACxxx","token":"tok1"},{"name":"twilio-b","sid":"ACyyy","token":"tok2"}]
TWILIO_ACCOUNTS=

# SignalWire (Compatibility API). Leave blank until Phase 3 provider is wired.
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_AUTH_TOKEN=
SIGNALWIRE_SPACE_URL=
# Shared secret for Call Flow Builder's "Request" node (HTTP Basic Auth, since it can't
# produce a signed webhook). Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SIGNALWIRE_CFB_WEBHOOK_SECRET=

RECONCILE_WINDOW_HOURS=4

# --- Asterisk / BulkVS telephony (additive, DARK + flag-gated) ----------------------
# Native-Asterisk + BulkVS SIP trunk as a 3rd provider. Ships OFF: with ASTERISK_ENABLED
# false nothing about the app changes (no telephony consumers, Twilio/SignalWire/GHL
# untouched). Flip true only after provisioning the host per asterisk/README.md.
# /health/telephony is the non-gating probe (NOT the container healthcheck).
ASTERISK_ENABLED=false
# ARI (Asterisk REST Interface) — the backend reaches it over the docker host-gateway;
# it is bound + UFW-locked to loopback/callmon-net, never public. Creds from env only.
ARI_HOST=host.docker.internal
ARI_PORT=8088
ARI_USERNAME=owen
ARI_PASSWORD=            # generate: openssl rand -hex 24
ARI_APP=owen             # Stasis application name
# Deploy-render only (used by envsubst on asterisk/http.conf, NOT read by the backend):
# the callmon-net gateway IP Asterisk binds ARI to, e.g. 172.20.0.1.
ARI_BIND_ADDR=127.0.0.1
# BulkVS SIP trunk. Inbound is IP-authed by the SBCs (see asterisk/README.md); the
# username/password cover outbound auth/registration. Secrets stay here, never in git.
BULKVS_TRUNK_NAME=bulkvs
BULKVS_SIP_USERNAME=
BULKVS_SIP_PASSWORD=
BULKVS_FROM_NUMBER=      # default outbound caller-ID, E.164 e.g. +1XXXXXXXXXX

# --- owen-voice: AI voice-agent media service (docs/AI_AGENT_SPEC.md) -------------------
# Runs the AI voice agents (steps 1-3). It reuses the ARI creds above, so NO ari.conf or
# extensions.conf change is required. Every value below has a working default — you only
# need to set them to move ports or relocate the service off this host.
#
# Its OWN Stasis app, which MUST differ from ARI_APP above: two consumers on one Stasis
# app fight over the same events, and the whole point is that owen-voice can crash or
# restart without touching live call handling.
VOICE_ARI_APP=owen-voice
# What we tell Asterisk to dial back on. MUST match the host side of the compose port
# publish ("127.0.0.1:9092:9092"). Loopback because Asterisk is native on this host —
# no docker bridge IP is hardcoded anywhere (cf. the 172.19.0.1 migration breakage).
VOICE_AUDIOSOCKET_ADVERTISE=127.0.0.1:9092
VOICE_AUDIOSOCKET_PORT=9092
VOICE_HTTP_PORT=8099
# `slin` = 8 kHz signed linear, what AudioSocket carries and what STT accepts directly.
VOICE_MEDIA_FORMAT=slin
# Hard ceiling on a spike self-test call, so a forgotten test cannot hold a trunk channel
# (BulkVS /trunkGroups reports MaxIn=10 concurrent inbound for this account).
VOICE_MAX_CALL_SECONDS=120
# Concurrent agent conversations (AI_AGENT_SPEC D10). Conservative on purpose and NOT a
# hardware limit: the trunk allows 10 concurrent inbound (BulkVS /trunkGroups MaxIn), so 4
# leaves 6 channels always free for ordinary flow calls and agents can never eat the trunk.
# At capacity the ai_agent node takes its `failed` port -> the flow's fallback (voicemail),
# which is a path that already works. Refusal is immediate; queueing would be dead air.
VOICE_MAX_SESSIONS=4
# Shared secret OWEN presents on POST /sessions. Generate: openssl rand -hex 24
VOICE_SERVICE_KEY=

# --- OWEN -> owen-voice (backend side of the same link) ---------------------------------
# Where the ai_agent flow node sends a live call. Must match VOICE_SERVICE_KEY above.
# Docker DNS on callmon-net. NOT host.docker.internal: owen-voice's control port is
# published on the host's loopback only, so a container reaching the host gateway
# times out and every agent call falls through to voicemail.
VOICE_SERVICE_URL=http://owen-voice:8099
VOICE_SERVICE_TIMEOUT_SECONDS=900

# Flow-prompt TTS (Ticket 15). Flow graphs store prompts as TEXT; the backend synthesizes
# them via OpenAI TTS (reuses OPENAI_API_KEY below) into 8kHz mono WAVs cached under
# <RECORDINGS_DIR>/tts/ and played by Asterisk via absolute-path sound: URIs. The native
# Asterisk host MUST see the recordings volume at the same absolute path — see
# asterisk/README.md ("Flow prompt TTS").
TTS_MODEL=tts-1
TTS_VOICE=alloy          # alloy | echo | fable | onyx | nova | shimmer

# Flow safety net (Ticket 15). If a flow-assigned DID's flow fails to load/crashes at the
# top of a call, blind-forward the caller to this number (E.164) instead of dead air.
# Empty = hang up cleanly instead of forwarding.
FLOW_FALLBACK_FORWARD_NUMBER=

# --- Default call handling for UNASSIGNED Asterisk DIDs (Ticket 18) -------------------------
# A BulkVS/Asterisk number with NO flow assigned no longer no-ops (which left dead air).
# Default: answer -> consent notice -> ring EVERY available operator softphone at once ->
# first to answer is bridged (others stop ringing) -> nobody available/answering => voicemail.
# Assigning a real flow to the number OVERRIDES all of this.
# See docs/DEFAULT_CALL_HANDLING_SPEC.md.
#   false = skip the operator ring and send unassigned DIDs straight to voicemail.
NO_FLOW_RING_OPERATORS=true
#   How long all available operators ring before the call rolls to voicemail.
OPERATOR_RING_TIMEOUT_SECONDS=25
#   Recording-consent notice played to the caller BEFORE operators ring (FL is all-party
#   consent). Plain text is TTS-synthesized; a "sound:" URI plays as-is; empty = no notice.
INBOUND_CONSENT_MEDIA=This call may be recorded for quality and training purposes.
#   Record operator-answered inbound calls (feeds transcription/analysis/GHL relay).
INBOUND_RECORDING_ENABLED=true

# Voicemail (the unassigned-number default AND the flow `voicemail` node). Greeting is played
# (plain text -> TTS), then a beep, then the caller is recorded until they hang up or fall
# silent. The WAV rides the existing recording->transcribe->analyze->GHL pipeline.
VOICEMAIL_GREETING=You've reached us, but we can't take your call right now. Please leave a message after the tone and we'll get back to you as soon as we can.
VOICEMAIL_MAX_DURATION_SECONDS=120
VOICEMAIL_MAX_SILENCE_SECONDS=5

# Transcription engine: dummy | openai. MUST be set to "openai" for real transcripts —
# "dummy" (the code default) silently returns a canned fake sentence for every call.
TRANSCRIPTION_ENGINE=openai
OPENAI_API_KEY=
# gpt-4o-transcribe (not whisper-1): same price ($0.006/min), far less prone to
# hallucinating fake text on short/near-silent audio. Does NOT support
# response_format=verbose_json (json/text only) — fine, that's what we send.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Dual-channel ("who said what") transcription. SignalWire's Start Call Recording node
# records in stereo — each call leg on its own channel — so the transcribe worker splits
# a 2-channel recording (ffmpeg) into two mono tracks, transcribes each, and merges them
# into a speaker-labeled transcript. Mono recordings (Twilio / pre-stereo) are unaffected.
STEREO_TRANSCRIPTION_ENABLED=true
# Which channel index (0/1) is the inbound caller. CONFIRM on a real stereo test call
# before trusting labels — flip this if Caller/Operator come out swapped.
STEREO_CALLER_CHANNEL=0
# Segment timestamps (to interleave the two legs) need whisper-1 — gpt-4o-transcribe can't
# return them. whisper-1 hallucinates on the silent stretches of a split channel, so its
# segments are filtered by these thresholds.
OPENAI_STEREO_TRANSCRIBE_MODEL=whisper-1
STEREO_MAX_NO_SPEECH_PROB=0.6
STEREO_MIN_AVG_LOGPROB=-1.2

# Voice AI agents (Ticket 11/12). Global kill-switch: blank = honour each agent's own `engine`;
# set to an engine name to FORCE every agent onto it (flip to "dummy" to instantly stop all real
# audio sessions). Engines: dummy (offline default) | openai_realtime | vapi | diy.
VOICE_AGENT_ENGINE=
# OpenAI Realtime runtime (Ticket 12) — a live spoken AI-agent conversation over AudioSocket.
# Only active when an agent (or the kill-switch) selects "openai_realtime". Reuses OPENAI_API_KEY
# (set above). Per-agent `model` overrides OPENAI_REALTIME_MODEL.
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy
# WS-reconnect retries before the session returns the `failed` port (→ voicemail). Keep at 1.
VOICE_AGENT_WS_RECONNECTS=1

# Analysis engine: dummy | claude | minimax
ANALYSIS_ENGINE=dummy
ANALYSIS_MODEL=MiniMax-M2
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1

RECORDINGS_DIR=/data/recordings
RECORDING_RETENTION_DAYS=30

# GoHighLevel inbound-SMS relay. Paste the URL of a GHL Workflow "Inbound Webhook"
# trigger; inbound texts received on tracking numbers are POSTed here as JSON.
# Leave blank to disable relay (messages are still stored in OWEN). Inbound-only —
# OWEN never sends outbound SMS, so this incurs no messaging charge.
GHL_INBOUND_WEBHOOK_URL=

# GoHighLevel parsed-email relay — two options, direct API preferred.
#
# Option A (preferred): direct v2 API. A parsed job email upserts a Contact and creates an
# Opportunity in a pipeline. No GHL premium per-execution charge; we handle retries/dedup.
# Create a sub-account Private Integration Token (Settings > Private Integrations) with
# contacts + opportunities read/write scopes. Pipeline/stage IDs are resolved via a one-off
# lookup and pasted here (leave stage blank to use the pipeline's first stage).
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
#
# Option B (fallback): GHL "Inbound Webhook" trigger URL (premium; ~$0.01/execution).
# Used only when GHL_API_TOKEN is empty. Blank = relay disabled (emails still stored).
GHL_EMAIL_WEBHOOK_URL=

# Inbound email ingestion (Hostinger IMAP). The worker polls this mailbox for job-
# notification emails (Dispatch / American Home Shield), parses them, and relays parsed
# ones to GHL_EMAIL_WEBHOOK_URL. Leave INBOUND_MAIL_HOST blank to disable the poller.
# Hostinger has no OAuth/app-passwords — use the real mailbox password over TLS (993).
# A dedicated mailbox is recommended. Only mail from INBOUND_MAIL_SENDER is ever touched.
INBOUND_MAIL_HOST=imap.hostinger.com
INBOUND_MAIL_PORT=993
INBOUND_MAIL_USER=santiago@dreamteammetalroofingandsolar.com
INBOUND_MAIL_PASSWORD=
INBOUND_MAIL_FOLDER=INBOX
INBOUND_MAIL_SENDER=notifications@dispatch.me
INBOUND_MAIL_POLL_SECONDS=90
INBOUND_MAIL_BATCH=25
INBOUND_MAIL_MARK_SEEN=true

# --- AI API (/api/ai/*) ---------------------------------------------------------------
# Read-only, API-key-authed access for AI agents and outside integrations. Keys are issued
# in the UI (API Keys) or with `make manage args='issue-key --name x --scope read'`.
# Full documentation: backend/app/api/ai/AI_API.md, also served at GET /api/ai/docs.
AI_API_ENABLED=true
AI_API_RATE_LIMIT_PER_MIN=60
AI_API_SQL_RATE_LIMIT_PER_MIN=10
AI_API_SQL_TIMEOUT_SECONDS=10
AI_API_SQL_DEFAULT_LIMIT=200
AI_API_SQL_MAX_LIMIT=5000

# Read-only Postgres login for POST /api/ai/query. THIS ROLE IS THE SECURITY BOUNDARY for
# ad-hoc SQL — with it unset, /query answers 503 rather than falling back to the app's
# read/write credentials, and every other AI endpoint keeps working.
#
# Create it ONCE on the host (needs CREATEROLE, which the app user deliberately lacks):
#   sudo -u postgres psql -d callmon -c "CREATE ROLE owen_ro LOGIN PASSWORD 'strong-password' \
#       NOSUPERUSER NOCREATEDB NOCREATEROLE NOINHERIT;"
# Grants are then applied and re-applied automatically at every app start (see
# backend/app/services/ro_role.py), including SELECT revocation on users / api_keys /
# api_key_usage, so future migrations that add tables are covered without another step.
POSTGRES_RO_USER=
POSTGRES_RO_PASSWORD=

# Observability. WARNING+ records from BOTH containers are mirrored into `app_logs` so
# GET /api/ai/errors can see them over HTTP (Docker's json-file logs are SSH-only and the
# app container cannot read the worker's). Set to ERROR for less, INFO to debug live —
# INFO mirrors every call-trace line into Postgres, so revert it afterwards.
APP_LOG_CAPTURE_LEVEL=WARNING
APP_LOG_RETENTION_DAYS=14
API_USAGE_RETENTION_DAYS=30
